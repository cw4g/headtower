# Headtower configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Only the two HEADSCALE_* values are needed to boot. Everything else is
# optional: identity providers, roles, and the agent are configured from the
# Settings panel once you're in (or via the vars below). Leave a var blank to
# use its default.

# --- Headscale connection (required for the no-wizard boot) ------------------
# Your Headscale server URL and an API key (`headscale apikeys create`). Set
# both and Headtower connects on startup, skipping the setup wizard. Leave them
# blank to configure the connection interactively at /setup instead.
HEADSCALE_URL=
HEADSCALE_API_KEY=

# --- Serving -----------------------------------------------------------------
# Host bind for the app. Use 127.0.0.1:3000 to bind localhost behind a proxy.
HEADTOWER_BIND=0.0.0.0:3000
# Serve under a sub-path, e.g. /admin. NOTE: baked at image build time, so the
# prebuilt GHCR image is root-path only; rebuild locally to change it.
HEADTOWER_BASE_PATH=

# --- Secrets -----------------------------------------------------------------
# Signs single sign-on (OIDC) sessions. REQUIRED before you enable SSO; a login
# attempt fails without it. Min 32 chars: `openssl rand -hex 32`.
HEADTOWER_SESSION_SECRET=
# Encrypts secrets (Headscale API key, OIDC client secrets) at rest in the local
# SQLite DB. Unset = stored in plaintext. Rotating it re-encrypts on next write.
HEADTOWER_SECRET=

# --- Optional agent (device metadata + browser SSH) --------------------------
# OFF by default. To enable: fill the four vars below and run
#   docker compose --profile agent up -d
# The agent joins your tailnet (tsnet) to report OS/version/endpoints the
# Headscale API doesn't expose, and to bridge browser SSH to nodes.
#
# A Headscale pre-auth key for the agent's own node (`headscale preauthkeys create`).
HEADTOWER_AGENT_AUTHKEY=
# Your Headscale URL (required when the agent is enabled).
HEADTOWER_AGENT_LOGIN_SERVER=
# Where the app reaches the agent in-cluster. Uncomment when enabling the agent.
# HEADTOWER_AGENT_URL=http://agent:8410
# Shared HMAC secret for the browser-SSH bridge; MUST match on app and agent.
# `openssl rand -hex 32`.
HEADTOWER_AGENT_SSH_SECRET=
# The agent's node name (must match on both services; default is fine).
HEADTOWER_AGENT_HOSTNAME=headtower-agent
